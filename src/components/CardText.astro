---
// Renders one card-text value (rules, effect, flavor, errata) as formatted,
// static HTML: keyword labels, glyphs, energy discs, italics, line breaks.
import { renderCardTextHtml } from '../lib/card-text';
import { glyphUrl } from '../lib/glyphs';
import { keywordChipStyle } from '../lib/keyword-styles';

interface Props {
	text: string;
}

const { text } = Astro.props;
const html = renderCardTextHtml(text, {
	resolveGlyph: glyphUrl,
	resolveKeyword: keywordChipStyle,
});
---

<span class="card-text" set:html={html} />
