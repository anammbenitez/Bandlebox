---
/**
 * Frame — the plain bark border around a working panel.
 *
 * Deliberately just a bordered box: a two-tone bark rail, a thin lantern
 * hairline inside it, and a warm dark fill. No images, no positioned pieces,
 * so it resizes and reflows like any other block. The painted branch lives on
 * the site header only.
 *
 * tone    bark = default; lit = a warmer fill for the deck sheet;
 *         quiet = the calmer fill behind the card browser
 */
interface Props {
	tone?: 'bark' | 'lit' | 'quiet';
	class?: string;
}

const { tone = 'bark', class: className } = Astro.props;
---

<div class:list={['frame', tone === 'lit' && 'frame--lit', tone === 'quiet' && 'frame--quiet', className]}>
	<div class="frame-body"><slot /></div>
</div>
