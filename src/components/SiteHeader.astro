---
import { getImage, Image } from 'astro:assets';
import logo from '../assets/brand/logo.webp';
import sprigUpper from '../assets/wood/sprig_horizontal_upper.png';
import sprigLower from '../assets/wood/sprig_horizontal_lower.png';

const img = async (src: ImageMetadata) => (await getImage({ src, width: src.width, format: 'webp', quality: 88 })).src;
const [sprigA, sprigB] = await Promise.all([img(sprigUpper), img(sprigLower)]);

const nav = [
	{ href: '/decks', label: 'Decks', match: (p: string) => p.startsWith('/decks') },
	{ href: '/', label: 'Browse cards', match: (p: string) => p === '/' },
];
const currentPath = Astro.url.pathname;
---

<!-- App-wide nav, fixed in place on scroll (spec: main navigation stays
     fixed): sticky keeps it in flow, so no body offset math is needed.
     Its underside is the first branch of the frame the whole app sits in.
     Takes no props: every page shows this exact header. -->
<header class="site-header sticky top-0 z-40 pb-1">
	<nav id="site-nav" class:list={['site-nav nav-wide mx-auto max-w-none gap-4 px-4 sm:gap-6']}>
		<a href="/" class="nav-brand" aria-label="BandleBox — home">
			<Image class="brand-mark" src={logo} alt="" width={40} height={41} densities={[1, 2, 3]} format="webp" quality={90} loading="eager" decoding="async" />
			<span>BandleBox</span>
		</a>
		{nav.map((n) => {
			const current = n.match(currentPath);
			return (
				<a class="nav-link" href={n.href} aria-current={current ? 'page' : undefined}>
					{current && (
						<span class="nav-mark" aria-hidden="true">
							<svg width="21" height="21" viewBox="0.9 -0.85 14 14" aria-hidden="true">
									<path d="M5.2 9C4.6 4.9 7.4 2 12.6 1.4 12.7 6.4 10 9.6 5.2 9Z" fill="currentColor" stroke="color-mix(in oklab, var(--color-amber-500) 55%, var(--color-bark-950))" stroke-width="0.7" stroke-linejoin="round" />
									<path d="M3.4 10.8 5.2 9M5.6 8.6C7.6 6.4 9.4 4.5 11.2 2.9" stroke="color-mix(in oklab, var(--color-amber-500) 55%, var(--color-bark-950))" stroke-width="0.8" fill="none" stroke-linecap="round" />
								</svg>
						</span>
					)}
					{n.label}
				</a>
			);
		})}
	</nav>
	<span class="header-sprig header-sprig--a" style={`background-image:url(${sprigA})`} aria-hidden="true"></span>
	<span class="header-sprig header-sprig--b" style={`background-image:url(${sprigB})`} aria-hidden="true"></span>
</header>
