---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
	title?: string;
	description?: string;
	/** Deck manager only (user request): full-window layout, uncapped width. */
	wide?: boolean;
	/** Deck manager only: the page fills the viewport and never scrolls; the
	 *  page's own panes carry the scrolling instead. */
	appShell?: boolean;
}

const { title = 'BandleBox', description = 'Personal, offline-first browser for every available Riftbound card.', wide = false, appShell = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class:list={['flex min-h-screen flex-col text-slate-100 antialiased', wide && 'is-wide', appShell && 'app-shell']}>
		<a class="skip-link" href="#main">Skip to content</a>
		<SiteHeader />
		<main id="main" tabindex="-1" class={`mx-auto w-full flex-1 px-4 focus:outline-none ${wide ? 'mx-0 pb-6 pt-0' : 'max-w-6xl pb-10 pt-9'}`}>
			<slot />
		</main>
		<footer class="colophon">
			<div class="colophon-row">
				<span class="colophon-own">Card data &amp; art: <span class="colophon-mark">RIFTBOUND</span> © Riot Games.</span>
				<span class="colophon-src">Catalog from <a class="colophon-link" href="https://openrift.app">OpenRift</a>.</span>
				<span class="colophon-note">Card images are requested from OpenRift when needed and never mirrored locally; card symbols are cached locally for offline reading.</span>
			</div>
		</footer>
	</body>
</html>
