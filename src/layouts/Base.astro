---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** Deck manager only (user request): full-window layout, uncapped width. */
	wide?: boolean;
}

const { title = 'Riftbound Deck Manager', description = 'Personal, offline-first browser for every available Riftbound card.', wide = false } = Astro.props;

const nav = [
	{ href: '/', label: 'Browse cards', match: (p: string) => p === '/' },
	{ href: '/sets', label: 'Sets', match: (p: string) => p.startsWith('/sets') },
	{ href: '/decks', label: 'Decks', match: (p: string) => p.startsWith('/decks') },
];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body class="flex min-h-screen flex-col bg-slate-950 text-slate-100 antialiased">
		<a class="skip-link" href="#main">Skip to content</a>
		<!-- App-wide nav, fixed in place on scroll (spec: main navigation stays
		     fixed): sticky keeps it in flow, so no body offset math is needed. -->
		<header class="sticky top-0 z-40 border-b border-slate-800 bg-slate-900/95">
			<nav id="site-nav" class="site-nav mx-auto max-w-6xl gap-4 px-4 sm:gap-6">
				<a href="/" class="nav-brand" aria-label="Riftbound Deck Manager — home">
					<svg class="text-amber-400" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
						<path d="M10 1.75 17 6v5.5L10 18.25 3 11.5V6z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
						<path d="M10 5.25v9.5M6.9 9.1h6.2" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
					</svg>
					<span>Riftbound</span>
					<span class="nav-brand-sub hidden sm:inline">Deck Manager</span>
				</a>
				{nav.map((n) => (
					<a class="nav-link" href={n.href} aria-current={n.match(currentPath) ? 'page' : undefined}>
						{n.label}
					</a>
				))}
			</nav>
		</header>
		<main id="main" tabindex="-1" class={`mx-auto w-full flex-1 px-4 py-6 focus:outline-none ${wide ? 'mx-0' : 'max-w-6xl'}`}>
			<slot />
		</main>
		<footer class="border-t border-slate-800 bg-slate-900/40 px-4 py-5 text-xs text-slate-500">
			<div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-2 gap-y-1.5">
				<span>Card data &amp; art: RIFTBOUND © Riot Games.</span>
				<span aria-hidden="true" class="text-slate-700">·</span>
				<span>Catalog from <a class="text-slate-300 hover:text-amber-300" href="https://openrift.app">OpenRift</a>.</span>
				<span aria-hidden="true" class="text-slate-700">·</span>
				<span>Card images are requested from OpenRift when needed and never mirrored locally; card symbols are cached locally for offline reading.</span>
			</div>
		</footer>
	<!-- impeccable-live-start -->
<script is:inline src="http://localhost:8400/live.js?token=21a3c89a-e617-4397-9d08-b30c44545c52"></script>
<!-- impeccable-live-end -->
</body>
</html>
