---
// One page per card (card-catalog-browser spec): built from the snapshot and
// readable without JavaScript. Everything is static React; two small
// framework-free behaviors add the card tilt and the Back button.
import Base from '../../layouts/Base.astro';
import { CardDetail } from '../../features/card-detail/CardDetail';
import { DeckReturnLink } from '../../features/card-detail/DeckReturnLink';
import { buildCardDetail } from '../../server/card-detail';
import { index, type IndexCard } from '../../server/catalog';

export function getStaticPaths() {
	return index.cards.map((card) => ({ params: { slug: card.slug }, props: { card } }));
}

interface Props {
	card: IndexCard;
}
const { card } = Astro.props;
const detail = buildCardDetail(card);
---

<Base title={`${card.name} — BandleBox`} roomy fitScreen>
	<DeckReturnLink />
	<CardDetail client:load card={detail} />
</Base>

<script>
	import '../../behaviors/card-tilt';
	import '../../behaviors/deck-return-link';
</script>
