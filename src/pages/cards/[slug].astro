---
import Base from '../../layouts/Base.astro';
import CardText from '../../components/CardText.astro';
import { imgAttrs } from '../../lib/card-image';
import { cardStats } from '../../lib/card-stats';
import { renderCardTextHtml } from '../../lib/card-text';
import { glyphUrl } from '../../lib/glyphs';
import { keywordChipStyle } from '../../lib/keyword-styles';
import {
	cardByUuid,
	channelLabels,
	domainLabels,
	enumLabel,
	errataOf,
	index,
	isBattlefield,
	markerLabels,
	representativePrinting,
	setPrimaryRelease,
	snapshot,
	type IndexCard,
	type IndexSet,
	type PrintingRecord,
} from '../../lib/catalog';

export function getStaticPaths() {
	return index.cards.map((card) => ({ params: { slug: card.slug }, props: { card } }));
}

interface Props {
	card: IndexCard;
}
const { card } = Astro.props;

const cardRecord = snapshot.cards[card.cardId];
const errata = errataOf(cardRecord);
const primaryIndex = representativePrinting(card);
const primaryPrint = primaryIndex ? snapshot.printings[primaryIndex.printingId] : undefined;
const rotateArt = isBattlefield(card);

const releaseSort = (a: IndexSet, b: IndexSet) => {
	const ra = setPrimaryRelease(a)?.releasedAt ?? '9999-99-99';
	const rb = setPrimaryRelease(b)?.releasedAt ?? '9999-99-99';
	return ra.localeCompare(rb) || a.name.localeCompare(b.name);
};

const printingsBySet = new Map<string, PrintingRecord[]>();
for (const printing of card.printings) {
	const list = printingsBySet.get(printing.setSlug) ?? [];
	const record = snapshot.printings[printing.printingId];
	if (record) list.push(record);
	printingsBySet.set(printing.setSlug, list);
}

const shownImageId = primaryIndex?.imageIds[0];

/** Detail art takes the `hero` role: full-size first (sharpest on high-DPI
 *  screens), degrading to 400w / 240w, then to the placeholder. */
const hero = shownImageId ? imgAttrs(shownImageId, 'hero', { rotate: rotateArt }) : null;

/** Detail stats: each figure carries the same symbol it has inside card text
 *  (derived in card-stats.ts, shared with the deck manager's card peek). */
const stats = cardStats(cardRecord);

const options = { resolveGlyph: glyphUrl, resolveKeyword: keywordChipStyle };
---

<Base title={`${card.name} — BandleBox`}>
	<!-- Back link. By default it goes to the card grid. When the deck manager sent the
	     reader here (its links carry ?from=<the deck's address>) the script below
	     turns it into "Back to deck", so the way back is the deck being built. -->
	<p class="text-xs">
		<a id="back-link" class="inline-flex items-center gap-1 text-slate-400 transition-colors hover:text-amber-300" href="/">
			<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
				<path d="M7.5 2.5 4 6l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
			<span id="back-label">All cards</span>
		</a>
	</p>

	<article class="mt-3 grid gap-8 lg:grid-cols-[300px_minmax(0,1fr)]">
		<div class="lg:sticky lg:top-20 lg:self-start">
			<!-- The stage is the card's own box and never moves; the face inside it leans
			     away from the mouse (src/scripts/card-tilt.ts, "card tilt" in global.css). -->
			<div data-tilt="large" class="mx-auto w-full max-w-[15rem] sm:max-w-[17rem] lg:mx-0 lg:max-w-none">
				<div data-tilt-face class={`relative ${rotateArt ? 'aspect-[7/5]' : 'aspect-[5/7]'} w-full overflow-hidden rounded-lg border border-slate-800 bg-slate-900 shadow-xl shadow-black/40`}>
					<div class="absolute inset-0 flex items-center justify-center text-xs text-slate-500">no art</div>
					{hero && (
						<img
							src={hero.src}
							alt={`${card.name} card art${primaryIndex?.setSlug ? ` (${primaryIndex.setSlug})` : ''}`}
							fetchpriority="high"
							width={hero.width}
							height={hero.height}
							class="absolute inset-0 h-full w-full object-cover"
							onerror={hero.onerror}
						/>
					)}
				</div>
			</div>
			{
				primaryPrint?.publicCode && (
					<p class="mt-2 text-xs text-slate-500 tnum">
						Shown: {primaryPrint.publicCode} · {enumLabel('artVariants', primaryPrint.artVariant)} art
					</p>
				)
			}
		</div>

		<div class="min-w-0">
			<h1 class="text-3xl font-semibold leading-tight">
				<!-- OpenRift courtesy link (design D5) -->
				<a class="transition-colors hover:text-amber-300" href={`https://openrift.app/cards/${card.slug}`}>{card.name}</a>
			</h1>

			<div class="mt-3 flex flex-wrap items-center gap-1.5 text-xs">
				{card.types.map((t) => <span class="rounded bg-slate-800 px-1.5 py-0.5 font-medium text-amber-300">{enumLabel('cardTypes', t)}</span>)}
				{(cardRecord.superTypes ?? []).map((st) => <span class="rounded border border-slate-700 px-1.5 py-0.5 text-slate-300">{enumLabel('superTypes', st)}</span>)}
				{domainLabels(cardRecord.domains).map((d) => <span class="rounded bg-slate-800/60 px-1.5 py-0.5 text-slate-300">{d}</span>)}
			</div>

			{stats.length > 0 && (
				<dl class="mt-5 flex flex-wrap gap-x-6 gap-y-3 border-y border-slate-800 py-3">
					{stats.map((stat) => (
						<div>
							<dt class="text-[10px] font-semibold tracking-[0.08em] uppercase text-slate-500">{stat.label}</dt>
							<dd class="mt-0.5 text-lg font-semibold leading-none text-slate-100 tnum">
								{stat.kind === 'energy' ? (
									<Fragment set:html={renderCardTextHtml(stat.symbol ?? '', options)} />
								) : (
									<>
										{stat.symbol && <Fragment set:html={renderCardTextHtml(stat.symbol, options)} />}
										<span class={stat.symbol ? 'ml-1' : undefined}>{stat.value}</span>
									</>
								)}
								{stat.note && <span class="ml-1 text-xs font-normal text-slate-400">{stat.note}</span>}
							</dd>
						</div>
					))}
				</dl>
			)}

			{
				cardRecord.maxCopiesOverride != null && (
					<div class="callout mt-4" data-tone="warning">
						Deck limit override: {cardRecord.maxCopiesOverride} copies
					</div>
				)
			}

			{
				errata && (
					<div class="callout mt-4 border-sky-400/30 bg-sky-400/5 text-sky-100">
						<strong class="font-semibold">Errata</strong>{errata.effectiveDate && <span class="text-sky-200/70"> · effective {errata.effectiveDate}</span>}
						<p class="mt-1">
							<CardText text={errata.correctedRulesText ?? errata.correctedEffectText ?? ''} />
						</p>
						{errata.sourceUrl && (
							<a class="mt-1 inline-block text-xs text-sky-300 hover:underline" href={errata.sourceUrl}>{errata.source}</a>
						)}
					</div>
				)
			}

			{
				(cardRecord.bans ?? []).length > 0 && (
					<div class="callout mt-4" data-tone="error">
						<strong class="font-semibold">Banned</strong>
						<ul class="mt-1 list-disc pl-4">
							{(cardRecord.bans ?? []).map((b) => (
								<li><span>{b.formatName}</span>{b.bannedAt && <span class="text-red-300/70"> · {b.bannedAt}</span>}{b.reason && <span class="text-red-300/70"> — {b.reason}</span>}</li>
							))}
						</ul>
					</div>
				)
			}

			<!-- The description is the printing's printed text and nothing else. The
			     card record's `keywords` field is an index, not printed content: the
			     text already carries each keyword as a [Keyword] label, so a separate
			     keyword row would read as a second description. -->
			<div class="mt-5 max-w-[70ch] space-y-3 text-sm leading-relaxed text-slate-200">
				{primaryPrint?.printedEffectText && (
					<p>
						<CardText text={primaryPrint.printedEffectText} />
					</p>
				)}
				{primaryPrint?.printedRulesText && (
					<p>
						<CardText text={primaryPrint.printedRulesText} />
					</p>
				)}
				{primaryPrint?.flavorText && (
					<p class="border-l border-slate-800 pl-3 italic text-slate-400">
						<CardText text={primaryPrint.flavorText} />
					</p>
				)}
			</div>

			<p class="mt-5 text-xs text-slate-500 tnum">{card.printings.length} printing{card.printings.length === 1 ? '' : 's'} in the snapshot</p>
		</div>
	</article>

	<h2 class="mt-12 border-b border-slate-800 pb-2 text-lg font-semibold">Printings</h2>
	{
		index.sets
			.filter((set) => printingsBySet.has(set.slug))
			.sort(releaseSort)
			.map((set) => {
				const prints = printingsBySet.get(set.slug) ?? [];
				return (
					<section class="mt-6">
						<h3 class="flex flex-wrap items-baseline gap-2 text-sm font-medium text-slate-200">
							{set.name}
							<span class="tag">{set.slug}</span>
							<span class="text-xs text-slate-500 tnum">{prints.length} printing{prints.length === 1 ? '' : 's'}</span>
						</h3>
						<ul class="mt-2 divide-y divide-slate-800 overflow-hidden rounded-lg border border-slate-800">
							{prints.map((printing) => {
								const channels = channelLabels(printing.distributionChannels);
								const markers = markerLabels(printing.markers);
								const side2 = printing.side2 ? cardByUuid.get(printing.side2.cardId) : undefined;
								const thumbId = printing.images?.[0]?.imageId;
								const thumb = thumbId ? imgAttrs(thumbId, 'thumb', { rotate: rotateArt }) : null;
								return (
									<li class={`grid gap-3 p-3 ${rotateArt ? 'sm:grid-cols-[120px_1fr]' : 'sm:grid-cols-[84px_1fr]'}`}>
										{thumb ? (
											<div class={`relative ${rotateArt ? 'aspect-[7/5]' : 'aspect-[5/7]'} w-full overflow-hidden rounded bg-slate-800`}>
												<img
													src={thumb.src}
													alt={`${card.name} card art — ${printing.publicCode ?? printing.shortCode ?? set.slug}`}
													loading="lazy"
													width={thumb.width}
													height={thumb.height}
													class="absolute inset-0 h-full w-full object-cover"
													onerror={thumb.onerror}
												/>
											</div>
										) : (
											<div class={`flex ${rotateArt ? 'aspect-[7/5]' : 'aspect-[5/7]'} w-full items-center justify-center rounded bg-slate-800 text-[10px] text-slate-500`}>no art</div>
										)}
										<div class="min-w-0 text-sm">
											<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
												<span class="font-semibold text-amber-300 tnum">{printing.publicCode ?? printing.shortCode ?? '—'}</span>
												<span class="text-slate-300">{enumLabel('rarities', printing.rarity)}</span>
												<span class="text-slate-500">·</span>
												<span class="text-slate-400">{enumLabel('finishes', printing.finish)}</span>
												{printing.artVariant && printing.artVariant !== 'normal' && <span class="tag">{enumLabel('artVariants', printing.artVariant)}</span>}
												{printing.isSigned && <span class="tag">Signed</span>}
												{printing.isOvernumbered && <span class="tag">Overnumbered</span>}
												{printing.size && printing.size !== 'standard' && <span class="tag">{enumLabel('cardSizes', printing.size)}</span>}
											</div>
											{printing.printedName && printing.printedName !== card.name && <div class="mt-1 text-slate-300">Printed name: {printing.printedName}</div>}
											<div class="mt-1 text-xs text-slate-500">
												{printing.artist && <span>Art by {printing.artist} · </span>}
												<span>{enumLabel('languages', printing.language)}</span>
											</div>
											{(channels.length > 0 || markers.length > 0) && (
												<div class="mt-2 flex flex-wrap items-center gap-1.5 text-xs">
													{channels.map((c) => <span class="rounded-full bg-slate-800/70 px-2 py-0.5 text-slate-300">{c}</span>)}
													{markers.map((m) => <span class="rounded-full border border-amber-400/40 px-2 py-0.5 text-amber-300">{m}</span>)}
												</div>
											)}
											{printing.comment && <div class="mt-1 text-xs italic text-slate-500">{printing.comment}</div>}
											{printing.side2 && (
												<div class="mt-2 rounded border border-slate-800 bg-slate-900 px-2.5 py-1.5 text-xs">
													<span class="font-medium text-slate-200">Two-sided card — back face:</span>
													{side2 ? (
														<a class="ml-1 text-amber-300 hover:underline" href={`/cards/${side2.slug}`}>
															{printing.side2.printedName ?? side2.name}
														</a>
													) : (
														<span class="ml-1">{printing.side2.printedName ?? 'unknown card'}</span>
													)}
													{printing.side2.publicCode && <span class="ml-2 text-slate-500">({printing.side2.publicCode})</span>}
												</div>
											)}
										</div>
									</li>
								);
							})}
						</ul>
					</section>
				);
			})
	}
</Base>

<script>
	import { cameFromBuilder, returnTarget } from '../../lib/deck-return';
	import '../../scripts/card-tilt';

	// Coming from the deck manager: the back link returns to that deck.
	const link = document.getElementById('back-link') as HTMLAnchorElement | null;
	const label = document.getElementById('back-label');
	const target = returnTarget(location.search);
	if (link && label && target) {
		link.href = target;
		label.textContent = 'Back to deck';
		// When the page before this one in the tab is that very deck, the browser's
		// own back restores it exactly as it was left (section, filters, scroll);
		// otherwise (a new tab, a pasted link) the link goes to the deck's address.
		link.addEventListener('click', (event) => {
			const plain = event.button === 0 && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey;
			if (plain && history.length > 1 && cameFromBuilder(document.referrer, location.origin)) {
				event.preventDefault();
				history.back();
			}
		});
	}
</script>
