---
// Deck manager (tasks 5.1-6.4). The server renders the payload programs (the
// same card payload the catalog grid uses, plus the snapshot's legality
// facts); everything interactive runs from src/scripts/deck-builder.ts —
// deck state, sections, browser, checklist, share. Decks come from the hash:
// #d/<id> opens a saved deck, #s/<payload> opens a shared one as view+copy.
// `wide` opts the page out of the site max-width (user request: full-window
// layout for the deck manager only).
import Base from '../../layouts/Base.astro';
import { SECTION_KEYS, SECTION_LABELS, sectionTarget } from '../../lib/deck';
import { buildDeckRuleIndexes } from '../../lib/deck-rules';
import { buildGridPayload, escapedJson } from '../../lib/grid-payload';
import { index, snapshot } from '../../lib/catalog';

const ruleIndexes = escapedJson(buildDeckRuleIndexes(snapshot, index));
const cardPayload = escapedJson(buildGridPayload());
const domainPayload = escapedJson(
	(snapshot.enums?.domains ?? []) as Array<{ slug: string; label?: string }>,
);
---

<Base title="Deck manager — Riftbound Deck Manager" wide>
	<!-- Deck chrome stays visible on scroll (spec: editor chrome stays visible):
	     the name/meta/actions bar sticks just below the fixed nav. --nav-h is
	     measured from #site-nav in deck-builder.ts. -->
	<header class="deck-bar">
		<div class="min-w-0">
			<h1 id="deck-name" class="deck-title truncate">Deck</h1>
			<p id="deck-meta" class="deck-meta">0 cards</p>
		</div>
		<div id="deck-actions" hidden class="flex flex-wrap items-center gap-1.5">
			<span id="deck-verdict" class="verdict" data-legal="unknown"><i class="dot"></i>—</span>
			<button id="deck-rename" type="button" class="btn">Rename</button>
			<button id="deck-share" type="button" class="btn">Copy deck link</button>
			<button id="deck-save-shared" type="button" hidden class="btn" data-variant="primary">Save as my deck</button>
			<a href="/decks" class="btn" data-variant="ghost" aria-label="All decks">
				<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
					<path d="M7.5 2.5 4 6l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
				</svg>
				<span>All decks</span>
			</a>
		</div>
	</header>

	<!-- refusals are visual by nature (the section flashes); this live region
	     carries the same message to screen readers -->
	<p id="deck-live" class="sr-only" role="status" aria-live="polite"></p>

	<div id="deck-storage-warning" hidden class="callout mt-4" data-tone="warning">
		Decks are not being saved this visit — browser storage is unavailable or full. Keep this window open, or try again in a normal browser window.
	</div>
	<div id="deck-unknown-warning" hidden class="callout mt-4" data-tone="warning"></div>
	<p id="deck-missing" hidden class="empty-state mt-6">
		This deck could not be loaded — it may have been deleted. Head back to <a class="text-amber-300 underline" href="/decks">your decks</a>.
	</p>
	<p id="deck-broken-share" hidden class="empty-state mt-6">
		This deck link is not a valid deck payload. Ask for the link again — copying it fresh usually fixes it.
	</p>
	<div id="deck-none" hidden class="mt-6">
		<a class="btn" data-variant="primary" href="/decks">Go to your decks</a>
	</div>

	<!-- viewer column width is user-adjustable via #deck-grip (spec: user-adjustable
	     viewer width); min(…, 50vw) is a CSS-side clamp backing the JS drag bounds.
	     The wider 520px default carries the field-zone layout (spec: deck viewer
	     presents the field zones) → the main deck reads large without the grip. -->
	<div
		id="deck-app"
		data-view="cards"
		class="mt-5 grid gap-6 lg:grid-cols-[minmax(0,1fr)_12px_min(var(--deck-viewer-w,520px),50vw)] lg:gap-0 lg:items-start xl:[--deck-viewer-w:520px]"
	>
		<!-- card browser -->
		<!-- viewport fit (spec: two-column layout fits the screen): each
		     working area caps at the screen height at lg+ and scrolls its own
		     contents; sticky keeps the other side pinned while one scrolls -->
		<section
			id="deck-browser"
			aria-label="Card browser"
			tabindex="-1"
			class="scroll-column min-w-0 lg:sticky lg:top-3 lg:max-h-[calc(100vh-1.5rem)] lg:overflow-y-auto lg:overscroll-contain"
		>
			<!-- browser chrome sticks inside the column scroller at lg+
			     (spec: scrolling the browser keeps its filters) -->
			<div id="bd-chrome" class="lg:sticky lg:top-0 lg:z-10 lg:bg-slate-950 lg:pb-2">
				<!-- section pills: generic retarget of the whole browser (spec: pill filters) -->
				<div id="bd-pills" class="flex flex-wrap items-center gap-1.5">
				{SECTION_KEYS.filter((k) => k !== 'side').map((key) => (
					<button type="button" data-pill={key} aria-pressed="false" class="pill">
						{key === 'rune' ? 'Runes' : SECTION_LABELS[key]}
					</button>
				))}
				<button type="button" data-pill="all" aria-pressed="false" class="pill">
					All
				</button>
			</div>
	<div class="mt-2 grid grid-cols-2 gap-2 lg:flex lg:flex-wrap lg:items-center">
				<input
					id="bd-search"
					class="field col-span-2 min-w-0 lg:min-w-48 lg:flex-1"
					type="search"
					placeholder="Search name or card text…"
					autocomplete="off"
				/>
				<select id="bd-type" class="field"></select>
				<select id="bd-rarity" class="field"></select>
				<select id="bd-set" class="field"></select>
				<button id="bd-reset" type="button" class="btn">Reset</button>
			</div>
			<!-- domain chips: the Legend's colors come preselected -->
				<div id="bd-domains" class="mt-2 flex flex-wrap items-center gap-1.5"></div>
			</div>
			<div class="mt-2 flex items-center justify-between gap-2">
				<p id="bd-count" class="text-xs text-slate-400 tnum" aria-live="polite"></p>
				<button type="button" class="btn lg:hidden" data-size="sm" data-scroll-to="deck-viewer">Deck <span id="deck-jump-count" class="tnum">0</span></button>
			</div>
			<!-- container-driven card grid (spec: card impressions size with their
			     container): auto-fill recomputes columns from the actual browser
			     column width — the viewer drag or a window resize reflows it -->
			<ul id="bd-list" class="mt-2 grid grid-cols-[repeat(auto-fill,minmax(10.5rem,1fr))] gap-3"></ul>
			<li id="bd-sentinel" class="col-span-full" aria-hidden="true"></li>
			<p id="bd-empty" hidden class="empty-state mt-4">No cards match the filters.</p>
			<p id="bd-hint" class="mt-2 text-[11px] text-slate-500">Added cards enter the focused section. Copy counts come from the deck panel.</p>
		</section>

		<!-- resize grip: sits in its own 12px grid column; capped to the
		     viewport at lg+ so the divider stays on screen with the columns -->
		<div id="deck-grip" class="hidden lg:block lg:sticky lg:top-3 lg:max-h-[calc(100vh-1.5rem)] lg:self-stretch" aria-hidden="true"></div>

		<!-- deck sections + checklist -->
		<aside
			id="deck-viewer"
			aria-label="Deck"
			tabindex="-1"
			class="scroll-column min-w-0 lg:sticky lg:top-3 lg:max-h-[calc(100vh-1.5rem)] lg:overflow-y-auto lg:overscroll-contain"
		>
			<!-- below lg the viewer sits under a long browser list: give the way
			     back to the cards the same one-tap affordance as the jump down -->
			<div class="mb-2 flex items-center justify-between lg:hidden">
				<span class="text-xs font-semibold tracking-[0.08em] uppercase text-slate-400">Deck</span>
				<button type="button" class="btn" data-size="sm" data-scroll-to="bd-list">
					<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
						<path d="M7.5 2.5 4 6l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
					Back to cards
				</button>
			</div>
			<div class="space-y-2.5">
				{SECTION_KEYS.map((key) => {
					const { exact, cap } = sectionTarget(key);
					return (
						<section data-section={key} class="section-card">
							<button type="button" data-focus-section={key} class="section-head">
								<span class="section-name">{SECTION_LABELS[key]}</span>
								<span class="section-count">
									<span data-count={key}>0</span>
									<span class="mx-1 text-slate-600">/</span>
									{exact != null ? String(exact) : `≤ ${cap}`}
								</span>
							</button>
							<div class="section-body">
								{key === 'rune' && <div data-rune-ratio class="mb-2 hidden"></div>}
								{key === 'legend' ? (
									<div class="grid grid-cols-[repeat(auto-fill,minmax(10rem,1fr))] gap-2">
										<ul data-rows="legend" class="contents"></ul>
										<div data-champion-zone class="min-w-0 rounded-md border border-slate-800/70 p-1.5">
											<div class="flex items-baseline justify-between gap-2 px-0.5">
												<span class="text-[10px] font-semibold tracking-[0.08em] uppercase text-slate-400">Champion</span>
												<span data-champion-count class="text-[10px] text-slate-400 tnum" aria-live="polite"></span>
											</div>
											<div data-champion-face class="mt-1.5"></div>
											<button
												type="button"
												data-champion-pick
												aria-pressed="false"
												class="btn mt-1.5 w-full"
												data-size="sm"
											>Select champion</button>
										</div>
									</div>
								) : key === 'battlefields' ? (
									<ul data-rows="battlefields" class="flex flex-wrap gap-1.5"></ul>
								) : (
									<ul data-rows={key} class="grid grid-cols-[repeat(auto-fill,minmax(6.5rem,1fr))] gap-1.5"></ul>
								)}
							</div>
						</section>
					);
				})}
			</div>

			<section class="panel mt-2.5" aria-label="Deck legality">
				<div class="panel-head">
					<h2 class="panel-title">Deck legality</h2>
					<span class="panel-count">Riftbound constructed</span>
				</div>
				<ul id="deck-checklist" class="check-list p-3"></ul>
			</section>
		</aside>
	</div>
</Base>

<style is:global>
	/* Below lg the browser is an endless list, so the deck cannot be reached by
	 * scrolling past it. The Deck / Back to cards buttons swap the two panes
	 * instead (a tab, not a scroll): the deck lands immediately below the bar. */
	@media (max-width: 63.99rem) {
		#deck-app[data-view='deck'] #deck-browser,
		#deck-app[data-view='deck'] #deck-grip {
			display: none;
		}
	}
	/* Copied-artwork battlefield thumbs sit sideways inside small boxes.
	 * `max-width: none` beats Tailwind preflight's img cap so 140% can cover
	 * the whole portrait box (the catalog grid uses max-w-none the same way). */
	#bd-list img[data-rotate] {
		position: absolute;
		inset: 0;
		width: 140%;
		max-width: none;
		height: auto;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%) rotate(90deg);
	}
	[data-section] img[data-rotate] {
		position: absolute;
		inset: 0;
		width: 140%;
		max-width: none;
		height: auto;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%) rotate(90deg);
	}
	/* deck viewer resize grip (spec: user-adjustable viewer width): a slim
	 * divider between the browser and viewer columns; the whole 12px grid
	 * column is the drag hit area. Hidden below lg with the stacked layout;
	 * capped to the viewport at lg+ with the confined columns. */	#deck-grip {
		position: relative;
		cursor: col-resize;
		touch-action: none;
		user-select: none;
	}
	#deck-grip::before {
		content: '';
		position: absolute;
		top: 4px;
		bottom: 4px;
		left: 50%;
		width: 2px;
		border-radius: 1px;
		transform: translateX(-50%);
		background: rgb(40 50 61 / 0.9); /* slate-700 */
	}
	#deck-grip:hover::before,
	#deck-grip[data-dragging]::before {
		width: 3px;
		background: color-mix(in oklab, #e6c27c 80%, transparent);
	}
	/* drag hover + refusal flashes on the drop-target sections (and the
	 * champion zone, which is a vetted drop target inside the Legend section) */
	[data-section].drag-accept,
	[data-champion-zone].drag-accept {
		outline: 2px solid color-mix(in oklab, #e6c27c 70%, transparent);
		outline-offset: 1px;
	}
	[data-section].drag-refuse {
		animation: refuse-flash 700ms ease-out;
	}
	@keyframes refuse-flash {
		0%, 40% {
			outline: 2px solid color-mix(in oklab, #dd6f6f 90%, transparent);
		}
		100% {
			outline: 2px solid transparent;
		}
	}
</style>

<script type="application/json" id="deck-card-data" set:html={cardPayload} />
<script type="application/json" id="deck-rules-data" set:html={ruleIndexes} />
<script type="application/json" id="deck-domains-data" set:html={domainPayload} />

<script>
	import '../../scripts/deck-builder';
</script>
