---
// Deck manager (deck-manager spec). The island owns everything interactive;
// the deck comes from the address (#d/<id> a saved deck, #s/<payload> a
// shared one). Card payload and rule indexes ride in JSON tags the island
// reads once it runs (design D3); the domain list is small enough for props.
// `wide` and `appShell`: the full-window shell that never scrolls itself.
import Base from '../../layouts/Base.astro';
import { DeckManager } from '../../features/deck-manager/DeckManager';
import { buildDeckRuleIndexes } from '../../domain/deck-rules';
import { glyphUrl } from '../../domain/glyphs';
import { PAYLOAD_IDS } from '../../domain/payload-ids';
import { index, snapshot } from '../../server/catalog';
import { buildGridPayload, escapedJson } from '../../server/grid-payload';

const ruleIndexes = escapedJson(buildDeckRuleIndexes(snapshot, index));
const cardPayload = escapedJson(buildGridPayload());
// Each domain carries OpenRift's emblem when the refresh cached one (the filter
// chips are the emblem alone); a domain without one is printed as its name.
const domains = ((snapshot.enums?.domains ?? []) as Array<{ slug: string; label?: string }>).map((domain) => ({
	...domain,
	icon: glyphUrl(`domain_${domain.slug}`) ?? null,
}));
---

<Base title="Deck manager — BandleBox" wide appShell>
	<DeckManager client:load domains={domains} />
	<script type="application/json" id={PAYLOAD_IDS.deckCards} set:html={cardPayload} />
	<script type="application/json" id={PAYLOAD_IDS.deckRules} set:html={ruleIndexes} />
</Base>

<style is:global>
	/* The deck editor owns the viewport: the page itself never scrolls, the
	 * framed panes do. main becomes the fixed working area between the site
	 * nav and the colophon, and #deck-app takes all of it. */
	body.app-shell {
		/* min-h-screen's 100vh outlives 100dvh on a phone with its URL bar
		 * showing; reset it or the body grows past the visible viewport. */
		min-height: 0;
		height: 100vh;
		height: 100dvh;
		overflow: hidden;
	}
	body.app-shell > main {
		display: flex;
		flex-direction: column;
		min-height: 0;
		overflow: hidden;
	}
	/* one row: whichever panes are visible share the full working height. */
	#deck-app {
		grid-template-rows: minmax(0, 1fr);
	}
	/* The colophon's long technical note is the only part of the footer that
	 * wraps; on a phone it would eat two lines of the working area. The
	 * attribution and source stay. */
	@media (max-width: 63.99rem) {
		body.app-shell .colophon-note {
			display: none;
		}
	}
	/* Below lg the browser and the deck can no longer stack and share one
	 * page scroll: they swap places, each scrolling inside its own frame. */
	@media (max-width: 63.99rem) {
		#deck-app[data-view='cards'] #deck-viewer {
			display: none;
		}
		#deck-app[data-view='deck'] #deck-browser,
		#deck-app[data-view='deck'] .bd-frame {
			display: none;
		}
	}
	/* Copied-artwork battlefield thumbs sit sideways inside small boxes.
	 * `max-width: none` beats Tailwind preflight's img cap so 140% can cover
	 * the whole portrait box (the catalog grid uses max-w-none the same way). */
	#bd-list img[data-rotate] {
		position: absolute;
		inset: 0;
		width: 140%;
		max-width: none;
		height: auto;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%) rotate(90deg);
	}
	[data-section] img[data-rotate] {
		position: absolute;
		inset: 0;
		width: 140%;
		max-width: none;
		height: auto;
		left: 50%;
		top: 50%;
		transform: translate(-50%, -50%) rotate(90deg);
	}
	/* drag hover + refusal flashes on the drop-target sections (and the
	 * champion zone, which is a vetted drop target inside the Legend section) */
	[data-section].drag-accept,
	[data-champion-zone].drag-accept {
		outline: 2px solid color-mix(in oklab, #e6c27c 70%, transparent);
		outline-offset: 1px;
	}
	[data-section].drag-refuse {
		animation: refuse-flash 700ms ease-out;
	}
	@keyframes refuse-flash {
		0%, 40% {
			outline: 2px solid color-mix(in oklab, #dd6f6f 90%, transparent);
		}
		100% {
			outline: 2px solid transparent;
		}
	}
</style>

