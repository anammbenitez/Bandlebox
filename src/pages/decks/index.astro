---
// Your decks (deck-library spec). The heading is static; the library is an
// island over the browser's decks. Rule indexes (for the legality badges) ride
// in a JSON tag the island reads once it runs; the Legends (tile covers and
// the picker) are small enough to pass as props.
import Base from '../../layouts/Base.astro';
import { DeckLibrary } from '../../features/deck-library/DeckLibrary';
import { buildDeckRuleIndexes } from '../../domain/deck-rules';
import { PAYLOAD_IDS } from '../../domain/payload-ids';
import { index, snapshot } from '../../server/catalog';
import { escapedJson } from '../../server/grid-payload';

const ruleIndexes = escapedJson(buildDeckRuleIndexes(snapshot, index));

const legends = index.cards
	.filter((card) => card.types.includes('legend'))
	.map((card) => {
		const printing = card.printings.find((p) => p.imageIds.length > 0) ?? card.printings[0];
		return { slug: card.slug, name: card.name, imageId: printing?.imageIds[0] ?? null };
	});
---

<Base title="Your decks — BandleBox">
	<header class="page-head">
		<div>
			<h1 class="page-title">Your decks</h1>
			<p class="page-lede">Decks live in this browser locally and save themselves as you build, be creative!</p>
		</div>
	</header>
	<DeckLibrary client:load legends={legends} />
	<script type="application/json" id={PAYLOAD_IDS.deckRules} set:html={ruleIndexes} />
</Base>

<script>
	import '../../behaviors/card-tilt';
</script>
