---
// Browse cards (card-catalog-browser spec). The heading is static; the grid is
// an island whose first step of tiles is rendered here at build. The full
// catalog payload rides in a JSON tag the grid reads once it runs (design D3).
import Base from '../layouts/Base.astro';
import { CatalogGrid } from '../features/catalog-grid/CatalogGrid';
import { CatalogHead } from '../features/catalog-grid/CatalogHead';
import { index, setPrimaryRelease } from '../server/catalog';
import { PAYLOAD_IDS } from '../domain/payload-ids';
import { buildGridPayload, escapedJson, GRID_STEP } from '../server/grid-payload';

const rarityOrder = ['common', 'uncommon', 'rare', 'epic', 'showcase'];
const typeOrder = ['legend', 'unit', 'spell', 'rune', 'gear', 'battlefield', 'other'];

const byKnownFirst = (order: string[], fallback: number) => (a: string, b: string) => {
	const ia = order.indexOf(a);
	const ib = order.indexOf(b);
	return (ia < 0 ? fallback : ia) - (ib < 0 ? fallback : ib);
};

const types = [...new Set(index.cards.flatMap((c) => c.types))].sort(byKnownFirst(typeOrder, 99));
const rarities = [...new Set(index.cards.flatMap((c) => c.printings.map((p) => p.rarity).filter((r): r is string => Boolean(r))))].sort(
	byKnownFirst(rarityOrder, 99),
);
const sets = [...index.sets]
	.sort((a, b) => {
		const ra = setPrimaryRelease(a)?.releasedAt ?? '9999-99-99';
		const rb = setPrimaryRelease(b)?.releasedAt ?? '9999-99-99';
		return ra.localeCompare(rb) || a.name.localeCompare(b.name);
	})
	.map((s) => ({ slug: s.slug, name: s.name }));

const payload = buildGridPayload();
const initial = payload.slice(0, GRID_STEP).map(({ slug, name, meta, art }) => ({ slug, name, meta, art }));
---

<Base title="Browse cards — BandleBox">
	<CatalogHead cardCount={index.cards.length} setCount={index.sets.length} />
	<CatalogGrid client:load initial={initial} total={payload.length} types={types} rarities={rarities} sets={sets} />
	<script type="application/json" id={PAYLOAD_IDS.grid} set:html={escapedJson(payload)} />
</Base>

<style is:global>
	/* Render cost stays proportional to what is on screen; the remembered
	 * (auto) sizes correct the rough fallback after first render. */
	#grid-list > li[data-slug] {
		content-visibility: auto;
		contain-intrinsic-size: auto 360px;
	}
	/* Restoring a scroll position lays every revealed tile out once, so their
	 * real heights are remembered (useGridPlace.ts). */
	#grid-list[data-measuring] > li[data-slug] {
		content-visibility: visible;
	}
</style>

<script>
	import '../behaviors/card-tilt';
</script>
