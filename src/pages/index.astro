---
import Base from '../layouts/Base.astro';
import { cardSearchText, imgUrl, index, isBattlefield, representativePrinting, setPrimaryRelease, type IndexCard } from '../lib/catalog';
import { GRID_STEP, gridItemHtml, type GridItemData } from '../lib/grid-item';

const rarityOrder = ['common', 'uncommon', 'rare', 'epic', 'showcase'];
const typeOrder = ['legend', 'unit', 'spell', 'rune', 'gear', 'battlefield', 'other'];

const byKnownFirst = (order: string[], fallback: number) => (a: string, b: string) => {
	const ia = order.indexOf(a);
	const ib = order.indexOf(b);
	return (ia < 0 ? fallback : ia) - (ib < 0 ? fallback : ib);
};

const types = [...new Set(index.cards.flatMap((c) => c.types))].sort(byKnownFirst(typeOrder, 99));
const rarities = [...new Set(index.cards.flatMap((c) => c.printings.map((p) => p.rarity).filter((r): r is string => Boolean(r))))].sort(
	byKnownFirst(rarityOrder, 99),
);
const sets = [...index.sets].sort((a, b) => {
	const ra = setPrimaryRelease(a)?.releasedAt ?? '9999-99-99';
	const rb = setPrimaryRelease(b)?.releasedAt ?? '9999-99-99';
	return ra.localeCompare(rb) || a.name.localeCompare(b.name);
});

// Client-side filter payload: precomputed everything the grid controller
// needs to filter, search, and rebuild items entirely in memory (no network
// round-trips). `art` carries the representative printing's image reference.
const payload = index.cards.map((card) => {
	const rep = representativePrinting(card);
	const imageId = rep?.imageIds[0];
	const rotateArt = isBattlefield(card);
	const entry: GridItemData & { types: string[]; rarities: string[]; sets: string[]; variants: number; text: string } = {
		slug: card.slug,
		name: card.name,
		types: card.types,
		rarities: [...new Set(card.printings.map((p) => p.rarity).filter((r): r is string => Boolean(r)))],
		sets: [...new Set(card.printings.map((p) => p.setSlug))],
		variants: card.printings.length,
		text: cardSearchText(card),
		meta: `${rep?.rarity ?? '—'} · ${card.types.join(' / ')}`,
		art: imageId
			? {
					url: imgUrl(imageId, '240w'),
					rotate: rotateArt,
					setSlug: rep?.setSlug ?? '',
				}
			: null,
	};
	return entry;
});
// <script> safety: escape any literal `<` so a card's text can never close
// the JSON tag early.
const gridPayload = JSON.stringify(payload).replace(/</g, '\\u003c');

// Server-rendered initial window; the controller reveals further steps.
const firstWindow = payload.slice(0, GRID_STEP).map(gridItemHtml).join('');
---

<Base title="Browse cards — Riftbound Deck Manager">
	<h1 class="text-2xl font-bold">Browse cards</h1>
	<p class="mt-1 text-sm text-slate-400">
		The whole local snapshot as a scrolling grid — filter by type, rarity, set, or free text. More cards appear as you scroll; card art loads from OpenRift.
	</p>

	<div class="mt-4 flex flex-wrap items-center gap-2">
		<input
			id="grid-search"
			type="search"
			placeholder="Search name or card text…"
			autocomplete="off"
			class="min-w-56 flex-1 rounded-md border border-slate-700 bg-slate-900 px-3 py-1.5 text-sm outline-none placeholder:text-slate-500 focus:border-amber-400/70"
		/>
		<select id="grid-type" class="rounded-md border border-slate-700 bg-slate-900 px-2 py-1.5 text-sm focus:border-amber-400/70">
			<option value="">All types</option>
			{types.map((t) => <option value={t}>{t}</option>)}
		</select>
		<select id="grid-rarity" class="rounded-md border border-slate-700 bg-slate-900 px-2 py-1.5 text-sm focus:border-amber-400/70">
			<option value="">All rarities</option>
			{rarities.map((r) => <option value={r}>{r}</option>)}
		</select>
		<select id="grid-set" class="rounded-md border border-slate-700 bg-slate-900 px-2 py-1.5 text-sm focus:border-amber-400/70">
			<option value="">All sets</option>
			{sets.map((s) => (
				<option value={s.slug}>{s.name} ({s.slug})</option>
			))}
		</select>
		<button id="grid-reset" type="button" class="rounded-md border border-slate-700 bg-slate-900 px-3 py-1.5 text-sm text-slate-300 hover:border-amber-400/60 hover:text-amber-200">Reset</button>
	</div>
	<p id="grid-count" class="mt-2 text-sm text-slate-400" aria-live="polite">Showing all {index.cards.length.toLocaleString('en-US')} cards</p>

	<ul id="grid-list" class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
		<Fragment set:html={firstWindow} />
		<li id="grid-sentinel" class="col-span-full" aria-hidden="true"></li>
	</ul>
	<p id="grid-empty" class="mt-8 hidden rounded-lg border border-slate-800 bg-slate-900 p-6 text-center text-slate-400">
		No cards match the current filters. Try <em>Reset</em> or shorter search text.
	</p>

	<button
		id="grid-top"
		type="button"
		hidden
		aria-label="Back to top"
		class="fixed bottom-6 right-6 z-20 rounded-full border border-amber-400/50 bg-slate-900/90 px-4 py-2 text-sm text-amber-200 shadow-lg backdrop-blur hover:border-amber-300"
	>
		Top
	</button>

	<script type="application/json" id="grid-data" set:html={gridPayload} />
</Base>

<style is:global>
	/* Render cost stays proportional to what is on screen; the remembered
	 * (auto) sizes correct the rough fallback after first render. */
	#grid-list > li[data-slug] {
		content-visibility: auto;
		contain-intrinsic-size: auto 460px;
	}
</style>

<script>
	import '../scripts/grid-filters';
</script>
