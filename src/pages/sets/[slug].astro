---
import Base from '../../layouts/Base.astro';
import { imgUrl, index, isBattlefield, releaseLabel, representativePrintingForSet, setPrimaryRelease, setTypeLabel, type IndexSet } from '../../lib/catalog';

export function getStaticPaths() {
	return index.sets.map((set) => ({ params: { slug: set.slug }, props: { set } }));
}

interface Props {
	set: IndexSet;
}
const { set } = Astro.props;

const cards = index.cards.filter((card) => card.printings.some((p) => p.setSlug === set.slug));
const release = setPrimaryRelease(set);
---

<Base title={`${set.name} (${set.slug}) — Riftbound Deck Manager`}>
	<p class="text-xs">
		<a class="inline-flex items-center gap-1 text-slate-400 transition-colors hover:text-amber-300" href="/sets">
			<svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
				<path d="M7.5 2.5 4 6l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
			All sets
		</a>
	</p>

	<header class="page-head mt-3">
		<div class="min-w-0">
			<h1 class="page-title flex flex-wrap items-baseline gap-2.5">
				{set.name}
				<span class="tag text-xs">{set.slug}</span>
			</h1>
			<p class="page-lede">
				{setTypeLabel(set)} · {cards.length} card{cards.length === 1 ? '' : 's'} · released {releaseLabel(release?.releasedAt, release?.precision)}
			</p>
		</div>
	</header>

	<ul class="mt-5 grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
		{
			cards.map((card) => {
				const rep = representativePrintingForSet(card, set.slug);
				const imageId = rep?.imageIds[0];
				const rotateArt = isBattlefield(card);
				return (
					<li>
						<a href={`/cards/${card.slug}`} class="card-tile group" title={card.name}>
							<div class="card-tile-art">
								<div class="absolute inset-0 flex items-center justify-center text-xs text-slate-500">no art</div>
								{imageId && (
									<img
										src={imgUrl(imageId, '240w')}
										alt={`${card.name} card art (${set.slug})`}
										loading="lazy"
										width={rotateArt ? 336 : 240}
										height={rotateArt ? 240 : 336}
										class={rotateArt ? 'absolute left-1/2 top-1/2 w-[140%] max-w-none -translate-x-1/2 -translate-y-1/2 rotate-90' : 'absolute inset-0 h-full w-full object-cover'}
										onerror="this.onerror=null;this.remove()"
									/>
								)}
							</div>
							<div class="card-tile-name truncate">{card.name}</div>
							<div class="card-tile-meta"><span class="truncate">{rep?.rarity ?? '—'} · {card.types.join(' / ')}</span></div>
						</a>
					</li>
				);
			})
		}
	</ul>
</Base>
