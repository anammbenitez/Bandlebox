---
import Base from '../../layouts/Base.astro';
import { index, setPrimaryRelease, setTypeLabel } from '../../lib/catalog';

const sets = [...index.sets].sort((a, b) => {
	const ra = setPrimaryRelease(a)?.releasedAt ?? '9999-99-99';
	const rb = setPrimaryRelease(b)?.releasedAt ?? '9999-99-99';
	return ra.localeCompare(rb) || a.name.localeCompare(b.name);
});
---

<Base title="Sets — Riftbound Deck Manager">
	<h1 class="text-2xl font-bold">Sets</h1>
	<p class="mt-1 text-sm text-slate-400">{sets.length} sets in the local catalog snapshot (fetched {index.meta.fetchedAt}).</p>
	<ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
		{
			sets.map((set) => {
				const release = setPrimaryRelease(set);
				const date = release?.releasedAt;
				const precision = release?.precision ?? 'day';
				return (
					<li>
						<a
							href={`/sets/${set.slug}`}
							class="block rounded-lg border border-slate-800 bg-slate-900 p-4 transition hover:border-amber-400/60 hover:bg-slate-900/70"
						>
							<div class="flex items-baseline justify-between gap-2">
								<span class="font-semibold">{set.name}</span>
								<span class="rounded bg-slate-800 px-1.5 py-0.5 text-xs font-medium text-amber-300">{set.slug}</span>
							</div>
							<div class="mt-2 flex items-center justify-between text-xs text-slate-400">
								<span>{setTypeLabel(set)}</span>
								<span title={precision !== 'day' ? `Release known only to the ${precision}` : undefined}>{date ?? '—'}</span>
							</div>
						</a>
					</li>
				);
			})
		}
	</ul>
</Base>
